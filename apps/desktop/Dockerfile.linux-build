# Local Linux builder that mirrors the linux cells of
# .github/workflows/release.yml (ubuntu-22.04 + webkit2gtk-4.1 + Rust stable).
# Produces the same .deb/.rpm/AppImage the CI would, without round-tripping
# through GitHub Actions - intended for quick bug-fix validation.
#
# Native build only: the container arch matches the target arch, so no
# cross-compile toolchain is needed. Build for x64 with this image as-is; for
# arm64, run an arm64 container of the same image under qemu
# (see scripts/docker-build-linux.sh --arm64).
#
# The image is arch-agnostic. `rustup` installs the host target's std by
# default, so a `tauri build --target <host-triple>` works without an extra
# `rustup target add`. restic is fetched at `npm ci` time by fetch-restic.mjs
# --host, which picks the binary matching the container arch (see build.rs:
# it stages by Cargo TARGET, and here host == target).

FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

# Same set as release.yml "Install Linux dependencies".
RUN apt-get update && apt-get install -y --no-install-recommends \
    libwebkit2gtk-4.1-dev \
    libssl-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    patchelf \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Node 22 (matches setup-node@v4). Tauri's beforeBuildCommand runs vue-tsc +
# vite, so Node is needed inside the container, not just on the host.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Rust stable (matches dtolnay/rust-toolchain@stable). Floating, like CI.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"
