# Rust build output at any depth (root workspace + standalone crates like
# apps/office-addin-cli and apps/desktop/src-tauri).
target/
**/*.rs.bk
node_modules/
dist/
.env
.DS_Store
example_docs/
.docvault/
.docvault-restic-check/
.docvault-metadata-check/
.docvault-ref-check/
.docvault-track-check/
# Cached restic release archives (populated by `npm run restic:fetch`).
/third_party/restic/**/.cache/
# Vendored restic binaries (fetched automatically by the build, never committed).
/third_party/restic/**/restic
/third_party/restic/**/restic.exe

# Local agent tool state
.claude/
.codex/
